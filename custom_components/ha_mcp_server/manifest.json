{
    "domain": "ha_mcp_server",
    "name": "MCP Server for Home Assistant",
    "codeowners": [
        "@adromir"
    ],
    "dependencies": [
        "http",
        "history",
        "automation",
        "logbook",
        "script",
        "input_boolean",
        "input_number",
        "input_select",
        "input_text",
        "input_datetime",
        "camera",
        "blueprint",
        "energy",
        "todo",
        "calendar",
        "template",
        "media_player",
        "notify",
        "tts",
        "person",
        "zone",
        "hassio",
        "recorder"
    ],
    "documentation": "https://github.com/adromir/homeassistant-mcp",
    "iot_class": "local_polling",
    "issue_tracker": "https://github.com/adromir/homeassistant-mcp/issues",
    "requirements": [
        "mcp>=1.1.2",
        "numpy",
